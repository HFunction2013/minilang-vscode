{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "minilang",
  "scopeName": "source.mil",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#require" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mil",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mil",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.mil",
          "match": "\\\\(?:[ntrbf\"\\\\0]|u[0-9a-fA-F]{4})"
        },
        {
          "name": "invalid.illegal.unknown-escape.mil",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.mil",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.mil",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mil",
          "match": "\\b(var|func|if|else|while|return|break)\\b"
        },
        {
          "name": "keyword.other.mil",
          "match": "\\b(print|println)\\b"
        },
        {
          "name": "keyword.control.import.mil",
          "match": "\\b(require)\\b"
        },
        {
          "name": "keyword.other.from.mil",
          "match": "\\b(from|in)\\b"
        },
        {
          "name": "constant.language.mil",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.mil",
          "match": "\\b(len|charAt|substr|toString|toInt|strcmp|readAll|array|argc|argv|readFile|fileExists|writeFile|system|readLine|readFileBytes|writeFileBytes|chr)\\b"
        }
      ]
    },
    "require": {
      "patterns": [
        {
          "comment": "require a, b from module;",
          "match": "\\b(require)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)\\s+(from)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.import.mil" },
            "2": { "name": "entity.name.function.mil" },
            "3": { "name": "keyword.other.from.mil" },
            "4": { "name": "entity.name.type.module.mil" }
          }
        },
        {
          "comment": "require module; / require a, b;",
          "match": "\\b(require)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)\\s*(?=[;\\s])",
          "captures": {
            "1": { "name": "keyword.control.import.mil" },
            "2": { "name": "entity.name.type.module.mil" }
          }
        },
        {
          "match": "\\b(from)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.from.mil" },
            "2": { "name": "entity.name.type.module.mil" }
          }
        },
        {
          "match": "\\b(in)\\s+(cwd|syslib)\\b",
          "captures": {
            "1": { "name": "keyword.other.from.mil" },
            "2": { "name": "constant.language.mil" }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.mil" },
            "2": { "name": "entity.name.function.mil" }
          }
        },
        {
          "name": "entity.name.function.mil",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.module.mil" },
            "2": { "name": "punctuation.accessor.mil" },
            "3": { "name": "entity.name.function.mil" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.mil",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.mil",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.mil",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.mil",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "meta.brace.curly.mil", "match": "[{}]" },
        { "name": "punctuation.definition.parameters.begin.mil", "match": "\\(" },
        { "name": "punctuation.definition.parameters.end.mil", "match": "\\)" },
        { "name": "meta.brace.square.mil", "match": "[\\[\\]]" },
        { "name": "punctuation.separator.comma.mil", "match": "," },
        { "name": "punctuation.terminator.statement.mil", "match": ";" }
      ]
    },
    "identifiers": {
      "name": "variable.other.mil",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
